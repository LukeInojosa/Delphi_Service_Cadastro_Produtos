function TFDQueryHelper.SetAllParams<T>(obj: T; prefix: String = ''): TFDQuery;
var
  paramName: String;
  typeNameAndPropValue: TPair<String, TValue>;
begin
  Result := Self;
  for paramName in obj.getPropNames() do
  begin
    typeNameAndPropValue := obj.getPropValue(paramName);
    Self.SetParam(prefix + paramName, typeNameAndPropValue.value, typeNameAndPropValue.key);
  end;
end;

function TFDQueryHelper.SetParam(paramName: String; paramValue: TValue;
  TypeName: String): TFDQuery;
var
  FParam :TFDParam;
  realValue: Integer;
begin
  Result := Self;
  FParam := Self.FindParam(paramName);
  Writeln('typename in set Param : ' + typename.toLower);
  if not Assigned(FParam) then
    Exit;
  if typeName.ToLower = 'string' then
  begin
    FParam.AsString := paramValue.AsString;
  end
  else if typeName.ToLower = 'integer' then
  begin
    FParam.AsInteger := paramValue.AsInteger;
  end
  else if typename.ToLower = 'uint64' then
  begin
    FParam.AsInteger := paramValue.AsInteger;
  end
  else if typename.ToLower = 'boolean' then
  begin
    if paramValue.AsBoolean then
    begin
      realValue := 1;
    end else
      realValue := 0;

    FParam.AsInteger := realValue;
  end
  else if typename.ToLower = 'tdatetime' then
  begin
    writeln(paramValue.AsType<TDateTime>.Format('yyyy-mm-dd'));
    FParam.AsString := (paramValue.AsType<TDateTime>).Format('yyyy-mm-dd');
  end
  else
  begin
     FParam.AsString := paramValue.AsString;
  end;
end;

