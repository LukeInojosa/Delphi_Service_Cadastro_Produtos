unit Errors.Api;

interface uses
  System.SysUtils,
  Horse.Commons;

type TCustomException = class helper for Exception
  function Status: Integer;
end;

type EValidation = class(Exception)
  constructor Create(const Msg: string = 'Erro de Validacao de Dados');
end;

implementation
{ EValidation }

constructor EValidation.Create(const Msg: string);
begin
  inherited Create(Msg);
  Status := ThttpStatus.BadRequest.ToInteger;
end;

end.
