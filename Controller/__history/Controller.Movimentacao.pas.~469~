unit Controller.Movimentacao;

interface

uses
  Controller,
  Model.Movimentacao,
  GBSwagger.Path.Attributes,
  Horse.GBSwagger.Registry,
  Horse.GBSwagger.Controller;

type
  [SwagPath('movimentacao', 'Movimentacao')]
  TControllerMovimentacao = class(THorseGBSwagger)
  public
    [SwagGET('{id}', 'Consulta Movimentacao Por ID')]
    [SwagParamPath('id', 'id da movimentacao' ,True,False)]
    [SwagParamQuery('id_produto', '',False, True)]
    [SwagParamQuery('id_nota', '',False, True)]
    [SwagParamQuery('data_inicial')]
    [SwagParamQuery('data_final')]
    [SwagParamQuery('tipo_operacao', '',False, True)]
    [SwagParamQuery('id_almoxarifado', '',False, True)]
    [SwagResponse(200,TMovimentacaoCadastroDireto,True, 'Movimentacoes')]
    procedure GetPorId;


    [SwagGET('{num_pagina}/{qtd_por_pagina}', 'Consulta Movimentacao Por ID')]
    [SwagParamPath('num_pagina', 'numero da pagina' ,True,True)]
    [SwagParamPath('qtd_por_pagina', 'quantidade de registros por pagina' ,True,True)]
    [SwagParamQuery('id_produto', '',False, True)]
    [SwagParamQuery('id_nota', '',False, True)]
    [SwagParamQuery('data_inicial')]
    [SwagParamQuery('data_final')]
    [SwagParamQuery('tipo_operacao', '',False, True)]
    [SwagParamQuery('id_almoxarifado', '',False, True)]
    [SwagResponse(200,TMovimentacaoCadastroDireto,True, 'Movimentacoes')]
    procedure GetPaginado;

    [SwagPOST('nota', 'Cria Movimentacao em nota')]
    [SwagParamBody('Movimentacao',TMovimentacao)]
    [SwagResponse(201, TMovimentacaoCadastroDireto)]
    procedure Post;

    [SwagPOST('direto', 'Cria Movimentacao direta')]
    [SwagParamBody('Movimentacao',TMovimentacaoCadastroDireto)]
    [SwagResponse(201, TMovimentacaoCadastroDireto)]
    procedure PostMovimentacaoDireta;

    [SwagPUT('{id}', 'Atualiza Movimentacao')]
    [SwagParamPath('id', 'id da movimentacao a ser atualizada', True, True)]
    [SwagParamBody('Movimentacao', TMovimentacao)]
    [SwagResponse(200, TMovimentacaoCadastroDireto)]
    procedure Put;

    [SwagDELETE('{id}', 'Deleta Movimentacao')]
    [SwagParamPath('id', 'id da movimentacao a ser atualizada', True, True)]
    [SwagResponse(200, TMovimentacaoCadastroDireto)]
    procedure Delete;
  end;

implementation uses
