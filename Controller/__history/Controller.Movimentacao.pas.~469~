{ TControllerMovimentacao }

procedure TControllerMovimentacao.Delete;
var
  RecMovimentacao: RMovimentacao;
  Movimentacao: TMovimentacao;
  listMovimentacao: TObjectList<TMovimentacao>;
  Nota: TNotas;
  Produto: TProdutos;
  jsonValue : TJsonObject;
  Transferencia: TTransferencia;
begin
  try
    Movimentacao := TMovimentacao.Create;

    if System.SysUtils.TryStrToUInt64(FRequest.Params['id'], RecMovimentacao.id) then
      Movimentacao.id := RecMovimentacao.id;

    Movimentacao := FServiceMovimentacao.ConsultaPorId(RecMovimentacao.id);

    if not Assigned(Movimentacao) then
      raise EConflict.Create('Movimentacao tentando ser deletada nao existe');

    Nota := FServiceNotas.ConsultaPorId(Movimentacao.id_nota);

    if Nota.concluida then
      raise EConflict.Create('Nao eh possivel excluir movimentacao de nota concluida');

    FServiceMovimentacao.ExcluirPorId(Movimentacao.id);

    Produto := FServiceProduto.ConsultaPorId(Movimentacao.id_produto);

    if not (
      Assigned(Nota) and
      Assigned(Produto)
    ) then
      raise Exception.Create('Nao foi encotrado Nota ou Produto da Movimentacao');

    jsonValue := Movimentacao.ToJSONObject;

    if Nota.tipo_operacao = 2 then
    begin
      Transferencia := FServiceTransferencia.Consulta(Nota.id);
      jsonValue.AddPair('id_almoxarifado_destino', TJSONNumber.Create(Transferencia.id_almoxarifado_destino));
    end;


    jsonValue.AddPair('descricao_produto', Produto.descricao);
    jsonValue.AddPair('tipo_operacao', TJSONNumber.Create(Nota.tipo_operacao));
    jsonValue.AddPair('concluida', TJSONBool.Create(Nota.concluida));
    jsonValue.AddPair('data_registro',FormatDateTime('yyyymmdd', Nota.data_registro));
    jsonValue.AddPair('observacao', Nota.observacao);
    jsonValue.AddPair('id_almoxarifado',  TJSONNumber.Create(Nota.id_almoxarifado));

    FResponse
      .Status(THTTPStatus.OK)
      .Send(jsonValue);
  finally
  end;

end;

procedure TControllerMovimentacao.GetPaginado;
var
  listMovimentacao: TObjectList<TMovimentacao>;
  RecMovimentacao : RMovimentacao;
  Movimentacao: TMovimentacao;
  Nota: TNotas;
  Produto: TProdutos;
  arrResponse: TJSONArray;
  jsonValue: TJSONObject;
  data_inicial : String;
  data_final:String;
  tipo_operacao:Integer;
  num_pagina:Integer;
  qtd_por_pagina:Integer;
  id_almoxarifado: UInt64;
  Transferenica: TTransferencia;
begin
  Movimentacao := nil;
  try
    Movimentacao := TMovimentacao.Create;
    num_pagina := 0;
    qtd_por_pagina := 0;
    tipo_operacao := -1000;
    id_almoxarifado := 0;

    if (
      (not FRequest.Params['num_pagina'].isEmpty) and
      (not FRequest.Params['qtd_por_pagina'].isEmpty) and
      System.SysUtils.TryStrToInt(FRequest.Params['num_pagina'],num_pagina) and
      System.SysUtils.TryStrToInt(FRequest.Params['qtd_por_pagina'],qtd_por_pagina)
    ) then
    begin
      if (num_pagina <> 0) and (qtd_por_pagina = 0) then
        raise EValidation.Create('Forneca qtd_por_pagina');
    end;

    if System.SysUtils.TryStrToUInt64(FRequest.Query['id_produto'],RecMovimentacao.id_produto) then
      Movimentacao.id_produto := RecMovimentacao.id_produto;

    if System.SysUtils.TryStrToUInt64(FRequest.Query['id_nota'],RecMovimentacao.id_nota) then
      Movimentacao.id_nota := RecMovimentacao.id_nota;

    if System.SysUtils.TryStrToInt(FRequest.Query['quantidade'],RecMovimentacao.quantidade) then
      Movimentacao.quantidade := RecMovimentacao.quantidade;

    if (
      (not FRequest.Query['data_inicial'].IsEmpty)
      and isValidDateString(FRequest.Query['data_inicial'])
    )then
      data_inicial := FRequest.Query['data_inicial'];

    if (
      (not FRequest.Query['data_final'].IsEmpty)
      and isValidDateString(FRequest.Query['data_final'])
    )then
      data_final := FRequest.Query['data_final'];

    if not FRequest.Query['tipo_operacao'].isEmpty then
      System.SysUtils.TryStrToInt(FRequest.Query['tipo_operacao'], tipo_operacao);

    if not FRequest.Query['id_almoxarifado'].isEmpty then
      System.SysUtils.TryStrToUInt64(FRequest.Query['id_almoxarifado'], id_almoxarifado);

    listMovimentacao := FServiceMovimentacao.Consulta(
      Movimentacao,
      tipo_operacao,
      id_almoxarifado,
      data_inicial,
      data_final,
      num_pagina,
      qtd_por_pagina);

    arrResponse := TJSONArray.Create;

    FreeAndNil(Movimentacao);
    for Movimentacao in listMovimentacao do
    begin
      Nota := FServiceNotas.ConsultaPorId(Movimentacao.id_nota);
      Produto := FServiceProduto.ConsultaPorId(Movimentacao.id_produto);

      if not (
        Assigned(Nota) and
        Assigned(Produto)
      ) then
        raise EConflict.Create('Nao foi encotrado Nota ou Produto da Movimentacao');

      jsonValue := Movimentacao.ToJSONObject;

      if Nota.tipo_operacao = 2 then
      begin
        Transferenica := FServiceTransferencia.Consulta(Nota.id);
        jsonValue.AddPair('id_almoxarifado_destino', TJSONNumber.Create(Transferenica.id_almoxarifado_destino));
      end;

      jsonValue.AddPair('descricao_produto', Produto.descricao);
      jsonValue.AddPair('tipo_operacao', TJSONNumber.Create(Nota.tipo_operacao));
      jsonValue.AddPair('concluida', TJSONBool.Create(Nota.concluida));
      jsonValue.AddPair('data_registro', FormatDateTime('yyyymmdd', Nota.data_registro));
      jsonValue.AddPair('observacao', Nota.observacao);
      jsonValue.AddPair('id_almoxarifado',  TJSONNumber.Create(Nota.id_almoxarifado));

      arrResponse.AddElement(jsonValue);
    end;

    FResponse
      .Status(THTTPStatus.OK)
      .Send(arrResponse);

  finally
    Movimentacao.Free;
  end;
end;

