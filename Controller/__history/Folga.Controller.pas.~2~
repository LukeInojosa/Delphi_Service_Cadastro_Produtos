procedure TController.Get(Req: THorseRequest; Res: THorseResponse; Next: TNextProc);
var
      conn: TFDConnection;
      qry: TFDQuery;
      arr: TJSONArray;
      obj: TJSONObject;
begin
  conn := TDatabaseConnection.GetConnection();
  qry := TFDQuery.Create(nil);

  arr := TJSONArray.Create;

  try
    qry.Connection := conn;
    qry.SQL.Text := 'SELECT ID, NOME FROM PRODUTOS';
    qry.Open;

    Res.Send(qry.ToJSONArray());
    arr := nil;
  finally
    conn.Free;
  end;
end;

