unit Controller.Movimentacao;

interface

uses Controller, Model.Usuario;

type
  TControllerMovimentacao = class(Controller.TController)
  public
    class procedure Get(Req: THorseRequest; Res: THorseResponse;
      Next: TNextProc);
    class procedure Post(Req: THorseRequest; Res: THorseResponse;
      Next: TNextProc);
    class procedure Put(Req: THorseRequest; Res: THorseResponse;
      Next: TNextProc);
    class procedure Delete(Req: THorseRequest; Res: THorseResponse;
      Next: TNextProc);
  end;

implementation uses
  Service.Notas, Service.Produtos, Service.Movimentacao,
  GBJSON.Helper,
  Horse.Commons,
  System.SysUtils,
  System.Generics.Collections,
  System.JSON, System.Rtti, Utils, Service.Usuario, Errors.Api, Model.Notas;
var
  FServiceNotas: TServiceNotas;
  FServiceProduto: TServiceProdutos;
  FServiceMovimentacao: TServiceMovimentacao;
  FServiceUsuario : TServiceUsuario;

{ TControllerMovimentacao }

class procedure TControllerMovimentacao.Delete(Req: THorseRequest;
  Res: THorseResponse; Next: TNextProc);
var
  RecMovimentacao: RMovimentacao;
  Movimentacao: TMovimentacao;
  listMovimentacao: TObjectList<TMovimentacao>;
  Nota: TNotas;
  Produto: TProdutos;
  jsonValue : TJsonObject;
  arrResponse: TJSONArray;
begin
  try
    Movimentacao := TMovimentacao.Create;

    if System.SysUtils.TryStrToUInt64(Req.Params['id'], RecMovimentacao.id) then
      Movimentacao.id := RecMovimentacao.id;

    if System.SysUtils.TryStrToUInt64(Req.Query['id_produto'], RecMovimentacao.id_produto) then
      Movimentacao.id_produto := RecMovimentacao.id_produto;

    if System.SysUtils.TryStrToUInt64(Req.Query['id_nota'], RecMovimentacao.id_nota) then
      Movimentacao.id_nota := RecMovimentacao.id_nota;

    listMovimentacao := FServiceMovimentacao.Excluir(Movimentacao);

    Movimentacao.Free;
    for Movimentacao in listMovimentacao do
    begin
      Nota := FServiceNotas.ConsultaPorId(Movimentacao.id_nota);
      Produto := FServiceProduto.ConsultaPorId(Movimentacao.id_produto);

      if not (
        Assigned(Nota) and
        Assigned(Produto)
      ) then
        raise Exception.Create('Nao foi encotrado Nota ou Produto da Movimentacao');

      jsonValue := Movimentacao.ToJSONObject;
      jsonValue.RemovePair('id_nota');
      jsonValue.RemovePair('id_produto');
      jsonValue.AddPair('Nota', Nota.ToJSONObject);
      jsonValue.AddPair('Produto', Produto.ToJSONObject);

      arrResponse.AddElement(jsonValue);
    end;

    Res
      .Status(THTTPStatus.OK)
      .Send(arrResponse);
  finally
  end;

end;

class procedure TControllerMovimentacao.Get(Req: THorseRequest;
  Res: THorseResponse; Next: TNextProc);
var
  listMovimentacao: TObjectList<TMovimentacao>;
  RecMovimentacao : RMovimentacao;
  Movimentacao: TMovimentacao;
  Nota: TNotas;
  Produto: TProdutos;
  arrResponse: TJSONArray;
  jsonValue: TJSONObject;
  data_inicial : String;
  data_final:String;
  tipo_operacao:Integer;
  num_pagina:Integer;
  qtd_por_pagina:Integer;
begin
  try
    Movimentacao := TMovimentacao.Create;

    if System.SysUtils.TryStrToUInt64(Req.Params['id'],RecMovimentacao.id) then
      Movimentacao.id := RecMovimentacao.id;

    if System.SysUtils.TryStrToUInt64(Req.Query['id_produto'],RecMovimentacao.id_produto) then
      Movimentacao.id_produto := RecMovimentacao.id_produto;

    if System.SysUtils.TryStrToUInt64(Req.Query['id_nota'],RecMovimentacao.id_nota) then
      Movimentacao.id_nota := RecMovimentacao.id_nota;

    if System.SysUtils.TryStrToInt(Req.Query['quantidade'],RecMovimentacao.quantidade) then
      Movimentacao.quantidade := RecMovimentacao.quantidade;

    tipo_operacao := -1000;

    if (
      (not Req.Query['data_inicial'].IsEmpty) 
      and isValidDateString(Req.Query['data_inicial'])
    )then
      data_inicial := Req.Query['data_inicial'];

    if (
      (not Req.Query['data_final'].IsEmpty) 
      and isValidDateString(Req.Query['data_final'])
    )then
      data_inicial := Req.Query['data_final'];

    if not Req.Query['tipo_operacao'].IsEmpty then
      tipo_operacao := Req.Query['tipo_operacao'].ToInteger;

    if not Req.Params['num_pagina'].IsEmpty then
      num_pagina :=  Req.Params['num_pagina'].ToInteger;
    
    if not Req.Params['qtd_por_pagina'].IsEmpty then  
      qtd_por_pagina := Req.Params['qtd_por_pagina'].ToInteger;
    
    listMovimentacao := FServiceMovimentacao.Consulta(
      Movimentacao, 
      tipo_operacao, 
      data_inicial, 
      data_final, 
      num_pagina,
      qtd_por_pagina);

    arrResponse := TJSONArray.Create;

    Movimentacao.Free;
    for Movimentacao in listMovimentacao do
    begin
      Nota := FServiceNotas.ConsultaPorId(Movimentacao.id_nota);
      Produto := FServiceProduto.ConsultaPorId(Movimentacao.id_produto);

      if not (
        Assigned(Nota) and
        Assigned(Produto)
      ) then
        raise Exception.Create('Nao foi encotrado Nota ou Produto da Movimentacao');

      jsonValue := Movimentacao.ToJSONObject;
      jsonValue.RemovePair('id_nota');
      jsonValue.RemovePair('id_produto');
      jsonValue.AddPair('Nota', Nota.ToJSONObject);
      jsonValue.AddPair('Produto', Produto.ToJSONObject);

      arrResponse.AddElement(jsonValue);
    end;

    Res
      .Status(THTTPStatus.OK)
      .Send(arrResponse);

  finally
  end;
end;

class procedure TControllerMovimentacao.Post(Req: THorseRequest;
  Res: THorseResponse; Next: TNextProc);
var
  listMovimentacao: TObjectList<TMovimentacao>;
  Movimentacao: TMovimentacao;
  RecMovimentacao: RMovimentacao;
  Produto : TProdutos;
  Nota: TNotas;
  jsonArray: TJSONArray;
  jsonBody: TJSONObject;
  jsonResponse: TJSONObject;
  Session: TUserSession;
  RecNota: RNotas;
  listUsuario: TObjectList<TUsuario>;
  Usuario: TUsuario;
  listNotas: TObjectList<TNotas>;
begin
  //if not Req.Sessions.TryGetSession(Session) then
  //  raise Exception.Create('usuario precisa estar logado para fazer esta operacao');
  try
    jsonBody := Req.Body<TJSONObject>;
    Movimentacao := TMovimentacao.Create;

    if not (
      jsonBody.TryGetValue('id_produto', RecMovimentacao.id_produto) and
      jsonBody.TryGetValue('quantidade', RecMovimentacao.quantidade)
    ) then
      raise EValidation.Create('Erro De Validacao de Dados');

    Movimentacao.id_produto := RecMovimentacao.id_produto;
    Movimentacao.quantidade := RecMovimentacao.quantidade;

    // movimentacao direta
    if not jsonBody.TryGetValue('id_nota', RecMovimentacao.id_nota) then
    begin
      Session := Req.Sessions.Session[TUserSession] as TUserSession;
      Usuario := TUsuario.Create;
      Usuario.nome := Session.Nome;
      listUsuario := FServiceUsuario.Consulta(Usuario);
      Usuario.Free;

      if not (
        Assigned(listUsuario) and
        (listUsuario.Count > 0)
      )then
        raise Exception.Create('Usuario Precisa Estar logado para criar movimentacao');

      Usuario := listUsuario[0];

      // criar nota
      if not (
        jsonBody.TryGetValue<Integer>('tipo_operacao', RecNota.tipo_operacao) and
        jsonBody.TryGetValue<TDateTime>('data_registro', RecNota.data_registro)
      )then
        raise Exception.Create('Forneca tipo_operacao e data_registro da movimentacao');

      Nota := TNotas.Create;
      Nota.data_registro := RecNota.data_registro;
      Nota.tipo_operacao := RecNota.tipo_operacao;
      Nota.usuario_responsavel := Usuario.id;
      Nota.id_almoxarifado := Usuario.id_almoxarifado;

      Nota := FServiceNotas.Criar(Nota);
      Produto := FServiceProduto.ConsultaPorId(RecMovimentacao.id_produto);

      if not FServiceProduto.EstaAtivo(Movimentacao.id_produto, Nota.id_almoxarifado) then
       raise Exception.Create('Nao eh possivel realizar movimentacao em produto inativo');

      if listNotas.Count = 0 then
        raise Exception.Create('Nao foi possivel criar notas com estes dados');

      Movimentacao.id_nota := Nota.id;

      try
        listMovimentacao := FServiceMovimentacao.Criar(Movimentacao);
        FServiceNotas.Concluir(Nota);
      except
        on E: Exception do
        begin
          if Assigned(listMovimentacao) and (listMovimentacao.Count > 0) then
            FServiceMovimentacao.Excluir(listMovimentacao[0]);
          FServiceNotas.ExcluirPorId(Nota.id)
          raise E;
        end;
      end;
    end
    else // movimentacao realizada em nota
    begin
      Movimentacao.id_nota := RecMovimentacao.id_nota;

      Produto := FServiceProduto.ConsultaPorId(RecMovimentacao.id_produto);
      Nota := FServiceNotas.ConsultaPorId(RecMovimentacao.id_nota);


      if not FServiceProduto.EstaAtivo(Movimentacao.id_produto, Nota.id_almoxarifado) then
       raise Exception.Create('Nao eh possivel realizar movimentacao em produto inativo');

      if Nota.concluida then
         raise Exception.Create('Nao eh possivel realizar movimentacao em nota concluida');

      if not (
        Assigned(Produto) and
        Assigned(Nota)
      ) then
         raise Exception.Create('Produto ou Nota da movimentacao nao existe');

      if RecMovimentacao.quantidade <= 0 then
         raise Exception.Create('Movimentacao nao pode ter quantidade <= 0');

      Movimentacao.id_produto := RecMovimentacao.id_produto;
      Movimentacao.id_nota := RecMovimentacao.id_nota;
      Movimentacao.quantidade := RecMovimentacao.quantidade;

      listMovimentacao := FServiceMovimentacao.Criar(Movimentacao);
    end;

    if listMovimentacao.Count = 0 then
      raise Exception.Create('Nao foi possivel criar movimentacao');

    jsonResponse := listMovimentacao[0].ToJSONObject();

    jsonResponse.RemovePair('id_nota');
    jsonResponse.AddPair('Nota', Nota.ToJSONObject );

    jsonResponse.RemovePair('id_produto');
    jsonResponse.AddPair('Produto', Produto.ToJSONObject);

    jsonArray := TJSONArray.Create;

    jsonArray.AddElement(jsonResponse);

    Res
      .Status(THttpStatus.OK)
      .Send(
        TJSONObject.Create
        .AddPair('data', jsonArray)
      );
  finally
    Movimentacao.free;
    Nota.Free;
    Produto.Free;
  end;
end;

class procedure TControllerMovimentacao.Put(Req: THorseRequest;
  Res: THorseResponse; Next: TNextProc);
var
  listMovimentacao: TObjectList<TMovimentacao>;
  Movimentacao : TMovimentacao;
  RecMovimentacao: RMovimentacao;
  jsonResponse: TJSONObject;
  jsonArray: TJSONArray;
  Nota: TNotas;
  Produto: TProdutos;
  jsonBody: TJSONObject;
begin
  try
    Movimentacao := TMovimentacao.Create;

    if not (
    System.SysUtils.TryStrToUInt64(Req.Params['id'],RecMovimentacao.id) 
    )then
      raise Exception.Create('Erro de validacao de dados: Forneca id da movimentacao que se deseja alterar');
    
    Movimentacao := FServiceMovimentacao.ConsultaPorId(RecMovimentacao.id); 

    if not Assigned(Movimentacao) then
      raise Exception.Create('Nao foi possivel encontrar movimentacao');

    // nota de origem nao pode estar concluida
    Nota := FServiceNotas.ConsultaPorId(Movimentacao.id_nota);
    if Nota.concluida = True then
      raise Exception.Create('Nao eh possivel alterar movimentacao, pois nota de origem ja foi concluida');

    Movimentacao.Free;
    
    jsonBody := Req.Body<TJSONObject>;
    
    Movimentacao := TMovimentacao.Create;
    Movimentacao.id := RecMovimentacao.id;
    
    if jsonBody.TryGetValue('id_produto', RecMovimentacao.id_produto) then
      Movimentacao.id_produto := RecMovimentacao.id_produto;

    if jsonBody.TryGetValue('id_nota', RecMovimentacao.id_nota) then
      Movimentacao.id_nota := RecMovimentacao.id_nota;

    if jsonBody.TryGetValue('quantidade', RecMovimentacao.quantidade) then
      Movimentacao.quantidade := RecMovimentacao.quantidade;

    if (
      Movimentacao.isFilled.Items['id_nota']
    ) then
    begin
      Nota := FServiceNotas.ConsultaPorId(Movimentacao.id_nota);
       // nao eh possivel alterar movimentacao para nota de destino concluida
      if Nota.concluida = True then
        raise Exception.Create('Nao eh possuvel alterar movimentacao em nota concluida');
    end;

    listMovimentacao := FServiceMovimentacao.Alterar(Movimentacao);

    if listMovimentacao.Count = 0 then
      raise Exception.Create('Nao foi possivel alterar a movimentacao');

    Nota := FServiceNotas.ConsultaPorId(listMovimentacao[0].id_nota);
    Produto := FServiceProduto.ConsultaPorId(listMovimentacao[0].id_produto);
      
    jsonResponse := listMovimentacao[0].ToJSONObject();

    jsonResponse.RemovePair('id_nota');
    jsonResponse.AddPair('Nota', Nota.ToJSONObject );

    jsonResponse.RemovePair('id_produto');
    jsonResponse.AddPair('Produto', Produto.ToJSONObject);

    jsonArray := TJSONArray.Create;

    jsonArray.AddElement(jsonResponse);

    Res
      .Status(THttpStatus.OK)
      .Send(
        TJSONObject.Create
        .AddPair('data', jsonArray)
      );
  finally
    Movimentacao.Free;
  end;
end;

initialization
  FServiceNotas:= TServiceNotas.Create;
  FServiceProduto:= TServiceProdutos.Create;
  FServiceMovimentacao:= TServiceMovimentacao.Create;
  FServiceUsuario := TServiceUsuario.Create;
finalization
  FServiceNotas.Free;
  FServiceProduto.Free;
  FServiceMovimentacao.Free;
  FServiceUsuario.Free;
end.
