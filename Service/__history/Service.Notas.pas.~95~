unit Service.Notas;

interface uses
  Model.Notas,
  Service,
  System.JSON,
  FireDAC.Comp.Client,
  Database.Query,
  GBJSON.Helper,
  System.Generics.Collections,
  System.Rtti,
  Utils;
type
  TFDQuery = FireDAC.Comp.Client.TFDQuery;
  TNotas = Model.Notas.TNotas;
  RNotas = Model.Notas.RNotas;

type TServiceNotas = class(TService)
  private
    Query: TFDQuery;
  public
    constructor Create();
    destructor Destroy(); override;
    function Criar(data: TNotas): TNotas;
    function Consulta(data: TNotas): TObjectList<TNotas>;
    function ConsultaPorId(id: UInt64 = 0): TNotas;
    function Excluir(data:TNotas):  TNotas;
    function ExcluirPorId(id: UInt64 = 0): TNotas;
    function Alterar(data: TNotas): TObjectList<TNotas>;
    function Concluir(data: TNotas): Boolean;
end;

implementation uses
    System.SysUtils, Data.DB, Errors.Api,
    FieldHelper;



{ TServiceNotas }

function TServiceNotas.Alterar(data: TNotas): TObjectList<TNotas>;
var
  fieldName: String;
  arrJson: TJSONArray;
  field : TField;
begin
  if not (
    Assigned(data) and
    data.isFilled.Items['id']
  ) then
    raise EValidation.Create('Erro De Validacao de Dados');

  Self.Query
    .StartQuery
    .AddToQuery('UPDATE NOTAS ')
    .AddToQuery('SET ')
    .AddToQuery(data.updateStringFields())
    .AddToQuery('WHERE ID = :ID ')
    .AddToQuery('RETURNING ')
    .AddToQuery(data.getAllFields())
    .SetAllParams<TNotas>(data)
    .Open();


  arrJSON := Self.Query.ConvertQueryToJSONArray(True, data.isFilled.Keys.ToArray);

  Result := TGBJSONDefault.Serializer<TNotas>
                          .JsonStringToList(arrJSON.ToJSON);
end;

function TServiceNotas.Concluir(data: TNotas): Boolean;
begin
  Self.Query
    .StartQuery
    .AddToQuery('UPDATE NOTAS SET CONCLUIDA = :CONCLUIDA WHERE ID = :ID')
    .SetAllParams<TNotas>(data)
    .Open();

end;

function TServiceNotas.Consulta(data: TNotas): TObjectList<TNotas>;
var
  key : String;
  arrJson: TJSONArray;
begin
  Writeln('- Notas : Consultando Notas');

  Self.Query
    .StartQuery()
    .AddToQuery('SELECT * FROM NOTAS')
    .AddToQuery('WHERE 1 = 1');

  if Assigned(data) then
  begin
    for key in data.isFilled.Keys do
    begin
      if data.isFilled.Items[key] then
         Self.Query
          .AddToQuery('AND ' + key + ' = ' + ':' + key)
    end;
    Self.Query.SetAllParams<TNotas>(data)
  end;

  Self.Query.Open();

  arrJSON := Self.Query.ConvertQueryToJSONArray();

  Result := TGBJSONDefault.Serializer<TNotas>
                          .JsonStringToList(arrJSON.ToJSON);
end;

function TServiceNotas.ConsultaPorId(id: UInt64): TNotas;
var
  arrJson: TJSONArray;
begin
  Result := TNotas.Create;

  Self.Query
    .StartQuery
    .AddToQuery('SELECT * FROM NOTAS WHERE ID = :ID')
    .SetParam('ID', id)
    .Open();

  if Self.Query.RecordCount = 0 then
    Exit(nil);

  arrJson := Self.Query.ConvertQueryToJSONArray(True, Result.isFilled.Keys.ToArray);

  Result.FromJSONObject(arrJson.Get(0) as TJSONObject);
end;

constructor TServiceNotas.Create;
begin
  inherited;
  Self.Query := TFDQuery.Create(nil);
  Self.Query.ConnectToDatabase(
    Self.FConnection
  );
end;

function TServiceNotas.Criar(data: TNotas): TNotas;
var
  fieldName: String;
  field: TField;
  json: TJSONObject;
begin
  Writeln('- Notas : Criando Notas');
  Result:= nil;
  if not (
    Assigned(data) and
    data.isFilled.Items['tipo_operacao'] and
    data.isFilled.Items['usuario_responsavel'] and
    data.isFilled.Items['id_almoxarifado']
  )then
    raise EValidation.Create('Erro De Validacao de Dados');

  Self.Query
    .StartQuery
    .AddToQuery('INSERT INTO NOTAS ')
    .AddToQuery('(' + data.getAllFields(True, '', ['concluida']) + ')')
    .AddToQuery('VALUES ')
    .AddToQuery('(' + data.getAllFields(True,':', ['concluida']) + ')')
    .AddToQuery('RETURNING ')
    .AddToQuery(data.getAllFields)
    .SetAllParams<TNotas>(data)
    .Open();;

  json := TJSONObject.Create();
  for fieldName in data.isFilled.Keys.ToArray do
  begin
    field := Self.Query.FindField(fieldName);
    if not Assigned(field) then
      continue;
    if field.isDate() then
    begin
      json.AddPair(
          fieldName,
          ConvertDateToJSONFormat(field.AsString));
      continue;
    end;

    json.AddPair(
          fieldName,
          field.AsString);
  end;

  Writeln('Query Executada: ' + Self.Query.Text);
  Result := TNotas.Create();
  Result.fromJSONObject(json);
end;

destructor TServiceNotas.Destroy;
begin
  Self.Query.free;
  inherited;
end;

function TServiceNotas.Excluir(data: TNotas): TNotas;
var
  json : TJSONObject;
  field: TField;
  fieldName: String;
begin
  if not (
    Assigned(data) and
    data.isFilled.Items['id']
  ) then
    raise EValidation.Create('Erro De Validacao de Dados');

  Self.Query
    .StartQuery()
    .AddToQuery('DELETE FROM NOTAS')
    .AddToQuery('WHERE ID = :ID')
    .AddToQuery('RETURNING ' + data.getAllFields())
    .SetParam('ID', data.id)
    .Open();

  json := TJSONObject.Create();
  for fieldName in data.isFilled.Keys.ToArray do
  begin
    field := Self.Query.FindField(fieldName);
    if not Assigned(field) then
      continue;
    if field.isDate() then
    begin
      json.AddPair(
          fieldName,
          ConvertDateToJSONFormat(field.AsString));
      continue;
    end;

    json.AddPair(
          fieldName,
          field.AsString);
  end;

  Writeln('Query Executada: ' + Self.Query.Text);
  Result := TNotas.Create();
  Result.fromJSONObject(json);
end;

function TServiceNotas.ExcluirPorId(id: UInt64): TNotas;
var
  arrJson: TJSONArray;
begin
  if id = 0 then
    raise Exception.Create('Forneca id da nota que se deseja excluid');

  Result := TNotas.Create;

  Self.Query
    .StartQuery
    .AddToQuery('DELETE FROM NOTAS')
    .AddToQuery('WHERE ID  = :ID')
    .AddToQuery('RETURNING ' + Result.getAllFields())
    .SetParam('ID', id)
    .Open();

  arrJson := Self.Query.ConvertQueryToJSONArray(true, Result.isFilled.Keys.ToArray);

  if arrJson.Count = 0 then
    Exit(nil);

  Result.FromJSONObject(arrJson.Get(0) as TJSONObject);

end;

end.
