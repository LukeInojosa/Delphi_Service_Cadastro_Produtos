function TServiceEstoque.Consulta(
  data: TEstoque): TObjectList<TEstoque>;
var
  jsonArray: TJSONArray;
  paramName: String;
begin
  if not (
    Assigned(data)
  ) then
    raise Exception.Create('Erro validacao de ');

  Self.Query
    .StartQuery
    .AddToQuery('SELECT * FROM ESTOQUE ')
    .AddToQuery('WHERE 1 = 1 ');

  for paramName in data.isFilled.Keys do
  begin
    if data.isFilled.Items[paramName] then
      Self.Query
        .AddToQuery(' AND ' + paramName + ' = ' + ':' + paramName)
  end;

  Self.Query
    .SetAllParams<TEstoque>(data)
    .Open();

  jsonArray := Self.Query.ConvertQueryToJSONArray();

  Result := TGBJSONDefault.Serializer<TEstoque>
                          .JsonStringToList(jsonArray.ToJSON);
end;


function TServiceEstoque.Consulta(id_produto,
  id_almoxarifado: UInt64): TEstoque;
var
  jsonResult : TJSONObject;
begin
  if (id_produto = 0) or (id_almoxarifado  = 0) then
    raise Exception.Create('Erro de validacao');

  Self.Query
    .StartQuery
    .AddToQuery('SELECT * FROM ESTOQUE WHERE ID_ALMOXARIFADO = :ID_ALMOXARIFADO AND ID_PRODUTO  = :ID_PRODUTO')
    .SetParam('ID_ALMOXARIFADO', id_almoxarifado)
    .SetParam('ID_PRODUTO', id_produto)
    .Open();

  jsonResult := Self.Query.ConvertQueryToJSONArray();

  if jsonResult.count = 0 then
    exit(nil);

  Result := TEstoque.Create;
  Result.FromJSONObject(jsonResult.Get(0) as TJSONObject);
end;


