function TServiceEstoque.getSaldo(id_almoxarifado, id_produto: UInt64): Integer;
var
  jsonArr: TJSONArray;
begin
  if not (
    (id_almoxarifado <> 0) and
    (id_produto <> 0)
  ) then
    raise Exception.Create('Erro de validacao de dados');

  Self.Query
    .StartQuery
    .AddToQuery('SELECT quantidade FROM ESTOQUE')
    .AddToQuery('WHERE ID_ALMOXARIFADO = :ID_ALMOXARIFADO')
    .AddToQuery('AND ID_PRODUTO = :ID_PRODUTO')
    .SetParam('ID_ALMOXARIFADO', id_almoxarifado)
    .SetParam('ID_PRODUTO', id_produto)
    .Open();

  jsonArr := Self.Query.ConvertQueryToJSONArray();

  if jsonArr.Count = 0 then
    Exit(0);

  Result := (jsonArr.Items[0] as TJSONObject).GetValue('quantidade').ToString.ToInteger;
end;

function TServiceEstoque.verificaSaldoEstoqueAposMovimentacao(
  id_nota: UInt64): TObjectList<TEstoque>;
var
  jsonResult: TJSONArray;
begin
  if id_nota = 0 then
    raise Exception.Create('forneca id da nota que se quer analisar a movimentacao');

  Self.Query
    .StartQuery
    .AddToQuery('SELECT M.ID_PRODUTO AS id_produto, ')
    .AddToQuery('(COALESCE(E.quantidade, 0) - M.quantidade) AS quantidade, CAST(COALESCE(ativo, 1) AS CHAR(1)) AS ativo')
    .AddToQuery('FROM MOVIMENTACAO M ')
    .AddToQuery('LEFT JOIN ESTOQUE E ')
    .AddToQuery('ON E.id_produto = M.id_produto ')
    .AddToQuery('AND E.id_almoxarifado = (SELECT N.id_almoxarifado FROM NOTAS N WHERE N.id = :ID_NOTA) ')
    .AddToQuery('WHERE M.id_nota = :ID_NOTA ')
    .SetParam('ID_NOTA', id_nota)
    .Open();

  jsonResult := Self.Query.ConvertQueryToJSONArray();

  Result := TGBJSONDefault.Serializer<TEstoque>
                           .JsonStringToList(jsonResult.ToJSON);
end;

