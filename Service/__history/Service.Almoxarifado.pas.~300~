{ TServiceAlmoxarifado }
constructor TServiceAlmoxarifado.Create();
begin
  inherited Create;
  Self.Query := TFDQuery.Create(nil);
  Self.Query.ConnectToDatabase(
    Self.FConnection
  );
end;

destructor TServiceAlmoxarifado.Destroy();
begin
  Self.Query.free;
  inherited Destroy;
end;

function TServiceAlmoxarifado.Alterar(data: TAlmoxarifado): TObjectList<TAlmoxarifado>;
var
  arrJSON : TJSONArray;
  fieldName: String;
  I : Integer;
  filledFields: TList<String>;
  field: TField;
  json: TJSONObject;
begin
  Writeln('- Almoxarifado : Alterando Almoxarifado');
  if not (Assigned(data) and  data.isFilled.Items['id']) then
    raise Exception.Create('erro na validacao de parametros. forneça id');

  Self.Query
    .StartQuery
    .AddToQuery('UPDATE ALMOXARIFADO')
    .AddToQuery('SET ');

  filledFields := data.getFilledFields;
  for I := 0 to filledFields.Count - 1 do
  begin
    if I <> 0 then
      Self.Query
        .AddToQuery(',');
    Self.Query
      .AddToQuery(
        filledFields[I] + ' = '+
        ':' + filledFields[I]);
  end;

  Self.Query
    .AddToQuery('WHERE ID = :ID')
    .AddToQuery('RETURNING ' + data.getAllFields)
    .SetAllParams<TAlmoxarifado>(data)
    .Open();

  json := TJSONObject.Create();
  for fieldName in data.isFilled.Keys.ToArray do
  begin
    field := Self.Query.FindField(fieldName);
    if not Assigned(field) then
      continue;
    if fieldName = 'ativo' then
    begin
      json.AddPair(fieldName,TJSONBool.Create(field.AsInteger = 1));
    end else
    begin
      json.AddPair(fieldName, field.AsString);
    end;
  end;

  arrJSON := TJSONArray.Create;
  arrJSON.AddElement(json);

  Result := TGBJSONDefault.Serializer<TAlmoxarifado>
                          .JsonStringToList(arrJSON.ToJSON);
end;

function TServiceAlmoxarifado.Consulta(data: TAlmoxarifado): TObjectList<TAlmoxarifado>;
var
  arrJSON: TJSONArray;
  obj: TJSONObject;
  paramName: String;
begin
  Self.Query
    .StartQuery
    .AddToQuery('SELECT * FROM ALMOXARIFADO WHERE 1 = 1 ');

  if Assigned(data) then
  begin
    for paramName in data.getFilledFields do
      Self.Query
        .AddToQuery(' AND ' + paramName + ' = ' + ':' + paramName);

    Self.Query
      .SetAllParams<TAlmoxarifado>(data)
      .Open();
  end;

  arrJSON := Self.Query.ConvertQueryToJSONArray();

  Result := TGBJSONDefault.Serializer<TAlmoxarifado>
                                    .JsonStringToList(arrJSON.ToJSON);
end;

