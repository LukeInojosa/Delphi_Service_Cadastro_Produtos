  System.Generics.Collections,
  System.Rtti;
type 
  IService = Service.IService;
  TFDQuery = FireDAC.Comp.Client.TFDQuery;
  TAlmoxarifado = Model.Almoxarifado.TAlmoxarifado;
  RAlmoxarifado = Model.Almoxarifado.RAlmoxarifado;

type TServiceAlmoxarifado = class(TService)
  private
    Query: TFDQuery;
  public
    constructor Create();
    destructor Destroy(); override;
    function Criar(data: TAlmoxarifado): TAlmoxarifado;
    function Consulta(data: TAlmoxarifado): TObjectList<TAlmoxarifado>;
    function Excluir(data:TAlmoxarifado):  TObjectList<TAlmoxarifado>;
    function Alterar(data: TAlmoxarifado): TObjectList<TAlmoxarifado>;
