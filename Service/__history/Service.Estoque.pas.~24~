function TServiceEstoque.Consulta(
  data: TEstoque): TObjectList<TEstoque>;
var
  jsonArray: TJSONArray;
  paramName: String;
begin
  if not (
    Assigned(data)
  ) then
    raise Exception.Create('Erro validacao de ');

  Self.Query
    .StartQuery
    .AddToQuery('SELECT * FROM ESTOQUE ')
    .AddToQuery('WHERE 1 = 1 ')

  for paramName in data.isFilled.Keys do
  begin
    if data.isFilled.Items[paramName] then
      Self.Query
        .AddToQuery(' AND ' + paramName + ' = ' + ':' + paramName)
  end;

  Self.Query
    .SetAllParams<TMovimentacao>(data)
    .Open();

  jsonArray := Self.Query.ConvertQueryToJSONArray();

  Result := TGBJSONDefault.Serializer<TEstoque>
                          .JsonStringToList(jsonArray.ToJSON);
end;

