unit Service.Notas;

interface uses
  Model.Notas,
  Service,
  Model.Movimentacao,
  System.JSON,
  FireDAC.Comp.Client,
  Database.Query,
  GBJSON.Helper,
  System.Generics.Collections,
  System.Rtti,
  Utils;
type
  TFDQuery = FireDAC.Comp.Client.TFDQuery;
  TNotas = Model.Notas.TNotas;
  RNotas = Model.Notas.RNotas;

type TServiceNotas = class(TService)
  private
    Query: TFDQuery;
  public
    constructor Create();
    destructor Destroy(); override;
    function Criar(data: TNotas): TNotas;
    function Consulta(data: TNotas): TObjectList<TNotas>;
    function ConsultaPorId(id: UInt64 = 0): TNotas;
    function Excluir(data:TNotas):  TNotas;
    function ExcluirPorId(id: UInt64 = 0): TNotas;
    function Alterar(data: TNotas): TObjectList<TNotas>;
    function Concluir(data: TNotas): Boolean;
    function PossuiTodosProdutosDoEstoque(data:TNotas;onlyAtivo: Boolean = True): Boolean;
