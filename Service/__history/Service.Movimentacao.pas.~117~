unit Service.Movimentacao;

interface uses
  Model.Movimentacao,
  Service,
  System.JSON,
  FireDAC.Comp.Client,
  Database.Query,
  GBJSON.Helper,
  System.Generics.Collections,
  System.Rtti;
type
  IService = Service.IService;
  TFDQuery = FireDAC.Comp.Client.TFDQuery;
  TMovimentacao = Model.Movimentacao.TMovimentacao;
  RMovimentacao = Model.Movimentacao.RMovimentacao;

type TServiceMovimentacao = class(TService)
  private
    Query: TFDQuery;
  public
    constructor Create();
    destructor Destroy(); override;
    function Criar(data: TMovimentacao): TObjectList<TMovimentacao>;
    function Consulta(  data: TMovimentacao; 
                        tipo_operacao: Integer = -1000; 
                        data_inicial: String = ''; 
                        data_final: String = '' ;
                        num_pagina: Integer = -1;
                        qtd_por_pagia: Integer = -1): TObjectList<TMovimentacao>;
    function ConsultaPorId(id: UInt64 =0): TMovimentacao;
    function Excluir(data: TMovimentacao): TObjectList<TMovimentacao>;
    function Alterar(data: TMovimentacao): TObjectList<TMovimentacao>;
    function ExcluirPorId(id: UInt64 = 0): TMovimentacao;
    function ExcluirPorProdutoEmNota(id_produto: UInt64 = 0; id_nota : UInt64 = 0): TMovimentacao;
end;

implementation uses
  System.SysUtils, Data.DB,
  Errors.Api, FieldHelper;
{ TServiceMovimentacao }

function TServiceMovimentacao.Alterar(
  data: TMovimentacao): TObjectList<TMovimentacao>;
var
  jsonArray: TJSONArray;
begin
  if not Assigned(data) then
    raise EValidation.Create('Erro De Validacao de Dados');

  Self.Query
    .StartQuery
    .AddToQuery('UPDATE MOVIMENTACAO')
    .AddToQuery('SET ' + data.updateStringFields );

  if data.isFilled.Items['id'] then
  begin
    Self.Query
      .AddToQuery('WHERE ID = :ID');
  end
  else if data.isFilled.Items['id_nota'] and data.isFilled.Items['id_produto'] then
  begin
    Self.Query
      .AddToQuery('WHERE ID_NOTA = :ID_NOTA AND ID_PRODUTO = :ID_PRODUTO');
  end
  else
  begin
    raise EValidation.Create('Erro De Validacao de Dados');
  end;

  Self.Query
    .AddToQuery('RETURNING ' + data.getAllFields)
    .SetAllParams<TMovimentacao>(data)
    .Open();

  jsonArray := Self.Query.ConvertQueryToJSONArray(True, data.isFilled.Keys.ToArray);

  Result := TGBJSONDefault.Serializer<TMovimentacao>
                          .JsonStringToList(jsonArray.ToJSON);
end;



function TServiceMovimentacao.Consulta(data: TMovimentacao;
  tipo_operacao: Integer; data_inicial, data_final: String; num_pagina,
  qtd_por_pagia: Integer): TObjectList<TMovimentacao>;
var
  paramName: String;
  jsonArray : TJSONArray;
begin
  Self.Query
   .StartQuery
   .AddToQuery('SELECT ')

  if num_pagina > 0 and qtd_por_pagina > 0 then
  begin
    Self.Query
      .AddToQuery('FIRST ' + (qtd_por_pagina).ToString)
      .AddToQuery('SKIP ' + (qtd_por_pagina*(num_pagina - 1)).ToString );
  end;

  Self.Query  
   .AddToQuery(' MOVIMENTACAO.ID AS ID, ID_PRODUTO, ID_NOTA, QUANTIDADE, TIPO_OPERACAO, DATA_REGISTRO')
   .AddToQuery('FROM MOVIMENTACAO INNER JOIN NOTAS ')
   .AddToQuery('ON MOVIMENTACAO.ID_NOTA = NOTAS.ID ')
   .AddToQuery('WHERE 1 = 1 ');

  if tipo_operacao > -1000 then
  begin
    Self.Query
      .AddToQuery('AND TIPO_OPERACAO = :TIPO_OPERACAO')
      .SetParam('TIPO_OPERACAO', tipo_operacao);
  end;

  if not data_inicial.IsEmpty  then
  begin
    Self.Query
      .AddToQuery('AND DATA_REGISTRO >= CAST(:DATA_INICIAL AS TIMESTAMP)')
      .SetParam('DATA_INICIAL', data_inicial);
  end;
  
  if not data_final.IsEmpty  then
  begin             
    Self.Query
      .AddToQuery('AND DATA_REGISTRO < CAST(:DATA_FINAL AS TIMESTAMP)')
      .SetParam('DATA_FINAL', data_final);    
  end;
  
  
  for paramName in data.isFilled.Keys do
  begin
    if data.isFilled.Items[paramName] then
      Self.Query
        .AddToQuery(' AND ' + paramName + ' = ' + ':' + paramName)
  end;

  Self.Query
    .SetAllParams<TMovimentacao>(data)
    .Open();

  jsonArray := Self.Query.ConvertQueryToJSONArray();

  Result := TGBJSONDefault.Serializer<TMovimentacao>
                       .JsonStringToList(jsonArray.ToJSON);
end;

function TServiceMovimentacao.ConsultaPorId(id: UInt64): TMovimentacao;
var
  jsonArray: TJSONArray;
begin
  if id = 0 then
    raise Exception.Create('Forneca id para realizar a consulta de movimentacao');

  Result := TMovimentacao.Create;
  
  Self.Query
    .StartQuery
    .AddToQuery('SELECT * FROM MOVIMENTACAO ')
    .AddToQuery('WHERE ID = :ID')
    .SetParam('ID', id)
    .Open();

  
  jsonArray := Self.Query.ConvertQueryToJSONArray(True, Result.isFilled.Keys.ToArray);

  if jsonArray.Count = 0 then
    Exit(nil);

  Result.FromJSONObject(jsonArray.Get(0) as TJSONObject);
end;


constructor TServiceMovimentacao.Create;
begin
  inherited;
  Self.Query := TFDQuery.Create(nil);
  Self.Query.ConnectToDatabase(
    Self.FConnection
  );
end;

function TServiceMovimentacao.Criar(
  data: TMovimentacao): TObjectList<TMovimentacao>;
var
  jsonArray: TJSONArray;
begin
   if not (
    Assigned(data) and
    data.isFilled.Items['quantidade'] and
    data.isFilled.Items['id_produto'] and
    data.isFilled.Items['id_nota']
   ) then
      raise EValidation.Create('Erro De Validacao de Dados');

   Self.Query
    .StartQuery
    .AddToQuery('INSERT INTO MOVIMENTACAO ')
    .AddToQuery('(' + data.getAllFields(True)  + ')')
    .AddToQuery('VALUES ')
    .AddToQuery('(' + data.getAllFields(True,':') + ')')
    .AddToQuery('RETURNING ')
    .AddToQuery(data.getAllFields())
    .SetAllParams<TMovimentacao>(data)
    .Open();

   jsonArray := Self.Query.ConvertQueryToJSONArray(True,data.isFilled.Keys.ToArray);

   Result := TGBJSONDefault.Serializer<TMovimentacao>
                           .JsonStringToList(jsonArray.ToJSON);
end;

destructor TServiceMovimentacao.Destroy;
begin
  Self.Query.Free;
  inherited;
end;

function TServiceMovimentacao.Excluir(data: TMovimentacao): TObjectList<TMovimentacao>;
var
  jsonArray: TJSONArray;
  excludedMov: TMovimentacao;
begin
  if not (
    Assigned(data)
    and (  data.isFilled.Items['id'] or
          (data.isFilled.Items['id_produto'] and data.isFilled.Items['id_nota'])
        )
  )then
    raise EValidation.Create('Erro De Validacao de Dados');

  if data.isFilled.Items['id'] then
  begin
    excludedMov := Self.ExcluirPorId(data.id);
  end
  else
  begin
    excludedMov := Self.ExcluirPorProdutoEmNota(data.id_produto, data.id_nota);
  end;

  Result := TObjectList<TMovimentacao>.Create;
  Result.Add(excludedMov);
end;

function TServiceMovimentacao.ExcluirPorId(id: UInt64): TMovimentacao;
var
  jsonArray: TJSONArray;
  listMovimentacao : TObjectList<TMovimentacao>;
begin
  try
    Result := TMovimentacao.Create;

    Self.Query
      .StartQuery
      .AddToQuery('DELETE FROM MOVIMENTACAO')
      .AddToQuery('WHERE ID = :ID')
      .AddToQuery('RETURNING ' + Result.getAllFields())
      .SetParam('ID', id)
      .Open();

    jsonArray := Self.Query.ConvertQueryToJSONArray(True, Result.isFilled.Keys.ToArray);

    if jsonArray.Count = 0 then
      Exit(nil);

    Result.FromJSONObject(jsonArray.Get(0) as TJSONObject);
  finally

  end;
end;

function TServiceMovimentacao.ExcluirPorProdutoEmNota(id_produto,
 id_nota : UInt64): TMovimentacao;
var
  jsonArray: TJSONArray;
  listMovimentacao : TObjectList<TMovimentacao>;
begin
  try
    Result := TMovimentacao.Create;

    Self.Query
      .StartQuery
      .AddToQuery('DELETE FROM MOVIMENTACAO')
      .AddToQuery('WHERE ID_NOTA = :ID_NOTA ')
      .AddToQuery('AND  ID_PRODUTO = :ID_PRODUTO')
      .AddToQuery('RETURNING ' + Result.getAllFields())
      .SetParam('ID_NOTA', id_nota)
      .SetParam('ID_PRODUTO', id_produto)
      .Open();

    jsonArray := Self.Query.ConvertQueryToJSONArray(True, Result.isFilled.Keys.ToArray);

    if jsonArray.Count = 0 then
      Exit(nil);

    Result.FromJSONObject(jsonArray.Get(0) as TJSONObject);
  finally

  end;
end;

end.
