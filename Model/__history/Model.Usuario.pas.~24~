unit Model.Usuario;
interface uses
  Model,
  GBSwagger.Model.Attributes,
  System.SysUtils,
  Database.Query,
  System.Generics.Collections,
  Helper.TObject,
  System.Rtti;

type TUsuario  = class(TModel)
  private
    FId : uInt64;
    FNome : String;
    FSenha : String;
    FIdAlmoxarifado : uInt64;

    procedure SetId(data : uInt64);
    procedure SetNome(data : String);
    procedure SetSenha(data : String);
    procedure SetIdAlmoxarifado(data : uInt64);

  public

    [SwagProp('id','',True, True)]
    property id: uInt64 read FId write SetId;

    [SwagProp('codigo','')]
    property nome: String read FNome write SetNome;

    [SwagProp('descricao','', True)]
    property senha: String read FSenha write SetSenha;

    [SwagProp('id_almoxarifado','', True)]
    property id_almoxarifado: uInt64 read FIdAlmoxarifado write SetIdAlmoxarifado;

    constructor Create();
    procedure Show();
end;

type RUsuario = Record
  id : uInt64;
  nome : String;
  senha : String;
  id_almoxarifado : uInt64;
End;

implementation
{ TUsuario }

constructor TUsuario.Create;
var
  paramName: String;
  valueAndType: TPair<String,TValue>;
begin
  inherited;
  for paramName in Self.getPropNames() do
  begin
    isFilled.AddOrSetValue(paramName, False);
  end;

  FId := 0;
  FNome := '';
  FSenha := '';
  FIdAlmoxarifado := 0;
end;

procedure TUsuario.SetId(data: uInt64);
var
  columnName:String;
begin
  columnName := 'ID';
  isFilled.Items[columnName.ToLower] := True;
  FId := data;
end;

procedure TUsuario.SetIdAlmoxarifado(data: uInt64);
var
  columnName:String;
begin
  columnName := 'ID_ALMOXARIFADO';
  isFilled.Items[columnName.ToLower] := True;
  FIdAlmoxarifado := data;
end;

procedure TUsuario.SetNome(data: String);
var
  columnName:String;
begin
  columnName := 'NOME';
  isFilled.Items[columnName.ToLower] := True;
  fNome := data;
end;

procedure TUsuario.SetSenha(data: String);
var
  columnName:String;
begin
  columnName := 'SENHA';
  isFilled.Items[columnName.ToLower] := True;
  fSenha := data;
end;

procedure TUsuario.Show;
begin
    Writeln(Format('{ id: %s, nome: %s, senha, %s, id_almoxarifado: %s}',
          [id.ToString,nome,senha,id_almoxarifado.ToString]))
end;

end.
