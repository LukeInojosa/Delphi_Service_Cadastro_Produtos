type RMovimentacao = Record
  id : uInt64;
  quantidade : Integer;
  id_produto : uInt64;
  id_nota : uInt64;
End;

implementation

{ TMovimentacao }

constructor TMovimentacao.Create;
var
  paramName: String;
begin
  inherited;
  for paramName in Self.getPropNames() do
    isFilled.AddOrSetValue(paramName, False);

  FId := 0;
  FQuantidade := -1;
  FIdProduto := 0;
  FIdNota := 0;
end;

procedure TMovimentacao.SetId(data: uInt64);
var
  columnName:String;
begin
  columnName := 'ID';
  isFilled.Items[columnName.ToLower] := True;
  FId := data;
end;

procedure TMovimentacao.SetIdNota(data: uInt64);
var
  columnName:String;
begin
  columnName := 'ID_NOTA';
  isFilled.Items[columnName.ToLower] := True;
  FIdNota := data;
end;

procedure TMovimentacao.SetIdProduto(data: uInt64);
var
  columnName:String;
begin
  columnName := 'ID_PRODUTO';
  isFilled.Items[columnName.ToLower] := True;
  FIdProduto := data;
end;

procedure TMovimentacao.SetQuantidade(data: Integer);
var
  columnName:String;
begin
  columnName := 'QUANTIDADE';
  isFilled.Items[columnName.ToLower] := True;
  FQuantidade := data;
end;

procedure TMovimentacao.Show;
begin
    Writeln(Format('{ id: %s, id_nota: %s, id_produto, %s, quantidade: %s}',
          [id.ToString,
          id_nota.ToString,
          id_produto.ToString,
          quantidade.ToString]))
end;

end.
